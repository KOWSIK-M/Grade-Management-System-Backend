package com.klef.gms.service;

import java.util.Map;

import org.springframework.security.oauth2.client.userinfo.*;
import org.springframework.security.oauth2.core.OAuth2AuthenticationException;
import org.springframework.security.oauth2.core.user.*;
import org.springframework.stereotype.Service;

import com.klef.gms.model.AuthProvider;
import com.klef.gms.model.User;
import com.klef.gms.repo.UserRepo;

import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class CustomOAuth2UserService implements OAuth2UserService<OAuth2UserRequest, OAuth2User> {

    private final UserRepo userRepo;

    @Override
    public OAuth2User loadUser(OAuth2UserRequest userRequest) throws OAuth2AuthenticationException {
        OAuth2UserService<OAuth2UserRequest, OAuth2User> delegate = new DefaultOAuth2UserService();
        OAuth2User oAuth2User = delegate.loadUser(userRequest);

        Map<String, Object> attributes = oAuth2User.getAttributes();

        String registrationId = userRequest.getClientRegistration().getRegistrationId(); // google, github
        AuthProvider provider = registrationId.equalsIgnoreCase("github") ? AuthProvider.GITHUB : AuthProvider.GOOGLE;

        String rawEmail = (String) attributes.get("email");

        // Fallback for GitHub users who may not have public email
        if (rawEmail == null && attributes.get("login") != null) {
            rawEmail = attributes.get("login") + "@github.com";
        }

        final String email = rawEmail; // ✅ make effectively final

        final String name = (String) attributes.get("name");
        if (name == null) {
            name = (String) attributes.get("login"); // GitHub fallback
        }

        String picture = (String) attributes.get("picture");
        if (picture == null && attributes.get("avatar_url") != null) {
            picture = (String) attributes.get("avatar_url"); // GitHub avatar
        }

        User user = userRepo.findByEmail(email).orElseGet(() ->
            userRepo.save(
                new User(
                    null,
                    email,
                    null, // password will be null for OAuth users
                    name,
                    picture,
                    provider,
                    true,
                    true
                )
            )
        );

        return oAuth2User; // You can wrap this in a custom user class if needed
    }
}
