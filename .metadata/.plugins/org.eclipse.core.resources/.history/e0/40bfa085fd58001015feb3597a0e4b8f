package com.klef.gms.service;

import java.util.Map;

import org.springframework.security.oauth2.client.userinfo.*;
import org.springframework.security.oauth2.core.OAuth2AuthenticationException;
import org.springframework.security.oauth2.core.user.*;
import org.springframework.stereotype.Service;

import com.klef.gms.model.AuthProvider;
import com.klef.gms.model.User;
import com.klef.gms.repo.UserRepo;

import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
@Override
public OAuth2User loadUser(OAuth2UserRequest userRequest) throws OAuth2AuthenticationException {
    OAuth2UserService<OAuth2UserRequest, OAuth2User> delegate = new DefaultOAuth2UserService();
    OAuth2User oAuth2User = delegate.loadUser(userRequest);

    Map<String, Object> attributes = oAuth2User.getAttributes();
    String registrationId = userRequest.getClientRegistration().getRegistrationId(); // "google" or "github"

    final String email;
    final String name;
    final String picture;

    if ("google".equals(registrationId)) {
        email = (String) attributes.get("email");
        name = (String) attributes.get("name");
        picture = (String) attributes.get("picture");
    } else if ("github".equals(registrationId)) {
        String tempEmail = (String) attributes.get("email");
        String tempName = (String) attributes.get("name");

        if (tempEmail == null && attributes.get("login") != null) {
            tempEmail = attributes.get("login") + "@github.com";
        }
        if (tempName == null && attributes.get("login") != null) {
            tempName = (String) attributes.get("login");
        }

        email = tempEmail;
        name = tempName;
        picture = (String) attributes.get("avatar_url");
    } else {
        throw new RuntimeException("Unsupported provider: " + registrationId);
    }

    if (email == null) {
        throw new RuntimeException("Email not available from OAuth2 provider.");
    }

    AuthProvider provider = AuthProvider.valueOf(registrationId.toUpperCase());

    User user = userRepo.findByEmail(email).orElseGet(() ->
        userRepo.save(
            User.builder()
                .email(email)
                .name(name)
                .profileImageUrl(picture)
                .authProvider(provider)
                .isVerified(true)
                .active(true)
                .build()
        )
    );

    return oAuth2User;
}


}
